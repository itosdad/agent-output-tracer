/* Layout-only, theme-agnostic CSS for the aot TUI.
 *
 * Color tokens are intentionally absent here. They live in the
 * engine-specific theme files (`codex.tcss`, `claude.tcss`) which
 * are loaded alongside this one. Edit only structural rules here:
 * padding, alignment, dock direction, sizing.
 *
 * IMPORTANT: do NOT redefine Textual's standard color variables
 * here either — Textual's own default CSS relies on them.
 */

AOTScreen {
    layout: vertical;
}

AOTScreen > Breadcrumb {
    dock: top;
    height: 1;
}

AOTScreen > FooterHints {
    dock: bottom;
    height: 1;
}

StatusBar {
    dock: bottom;
    height: 1;
}

AOTScreen > .body {
    height: 1fr;
    width: 100%;
    padding: 1 2;
    /* No `align` rule here — Textual's CSS_PATH loads after every
     * widget's DEFAULT_CSS, so anything declared here would beat
     * per-screen subclass overrides at equal specificity. Each
     * screen's own DEFAULT_CSS sets its alignment explicitly:
     *
     *   - Compact screens (Stats / Doctor / Theme / Config /
     *     Trace / Search / Find vocab / TraceResults / Home):
     *     `align: center middle` — sit in the visual middle.
     *
     *   - Filling screens (Timeline / Sessions / EventDetail /
     *     FindResults / SearchResults): natural top-left
     *     anchoring with explicit `height: 1fr` on the content
     *     widget so it fills, plus a `max-width` cap.
     */
}
