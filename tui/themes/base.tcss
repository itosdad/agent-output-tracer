/* Layout-only, theme-agnostic CSS for the aot TUI.
 *
 * Color tokens are intentionally absent here. They live in the
 * engine-specific theme files (`codex.tcss`, `claude.tcss`) which
 * are loaded alongside this one. Edit only structural rules here:
 * padding, alignment, dock direction, sizing.
 *
 * IMPORTANT: do NOT redefine Textual's standard color variables
 * here either — Textual's own default CSS relies on them.
 */

AOTScreen {
    layout: vertical;
}

AOTScreen > Breadcrumb {
    dock: top;
    height: 1;
}

AOTScreen > FooterHints {
    dock: bottom;
    height: 1;
}

StatusBar {
    dock: bottom;
    height: 1;
}

AOTScreen > .body {
    height: 1fr;
    width: 100%;
    padding: 1 2;
    /* Anchor screen content to the top-left. Without this, a single
     * short widget inside the body container (e.g. the Stats card,
     * the Doctor report, the Find vocab list before the user has
     * scrolled) sits in the visual middle of the viewport — Textual's
     * default vertical alignment for a partially-filled container. */
    align: left top;
    content-align: left top;
}

/* The Vertical wrapper used by Home / Sessions / Trace / Search /
 * Config to stack multiple widgets must respect the same anchor so
 * the banner + list + preview don't drift downward. */
AOTScreen > .body Vertical {
    align: left top;
    content-align: left top;
}
