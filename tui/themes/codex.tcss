/* Chrome styling — theme-neutral.
 *
 * Historical note: this file used to be codex-specific (hardcoded
 * `cyan`) when there was only one theme. Phase 3.A added a second
 * theme (Claude / salmon), so every chrome rule was leaking the
 * codex cyan onto the Claude theme. The fix is to read `$accent`
 * — Textual's standard CSS variable, automatically bound to the
 * active Theme dataclass's `accent` field — instead of literal
 * colour names.
 *
 * Cited tokens from openai/codex (Rust workspace, codex-rs/tui/)
 * commit c03cea4 (2026-05-15) — kept as design provenance:
 *   accent (dark bg):       Cyan + BOLD              tui/src/style.rs:44
 *   accent (light bg):      RGB(0,95,135) + BOLD     tui/src/style.rs:9,42
 *   diff add fg:            Green                    tui/src/diff_render.rs:1231
 *   diff del fg:            Red                      tui/src/diff_render.rs:1243
 *   user prefix:            `›` bold dim             tui/src/history_cell/messages.rs:170
 *   tool detail prefix:     `  └ `                   tui/src/status_indicator_widget.rs:35
 *   quote gutter:           `  │ `                   tui/src/insert_history.rs:634
 *
 * IMPORTANT: We READ standard Textual tokens ($accent, $surface,
 * $panel, $text-muted) but never REDEFINE them — that corrupts
 * Textual's internal default CSS (e.g. `Screen.-maximized-view`'s
 * `hatch: right $panel`).
 */

Breadcrumb {
    color: $accent;
    text-style: bold;
}

FooterHints {
    color: $text-muted;
}

StatusBar {
    color: $text-muted;
}

#home-list {
    border: none;
    padding: 0;
}

#sessions-table,
#timeline-table {
    border: none;
}

#event-detail {
    padding: 0 1;
}

InlinePrompt {
    background: $surface;
}

InlinePrompt > Static.prompt-label {
    color: $accent;
    text-style: bold;
}
